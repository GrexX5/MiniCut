# Copier vers `.env` en local. Sur Koyeb : renseigner comme variables d'environnement.
ENV=dev
FRONTEND_ORIGINS=http://localhost:3000
# Dev local :
DATABASE_URL=sqlite:///./minicut.db
# Prod TiDB Serverless (MySQL-compatible) :
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@GATEWAY:4000/minicut?ssl_ca=/etc/ssl/certs/ca-certificates.crt&ssl_verify_cert=true
TMP_DIR=./tmp
FILE_TTL_SECONDS=600
MAX_CLIP_DURATION=300
DAILY_QUOTA_ANON=1
DAILY_QUOTA_FREE=10
# Optionnel — anti IP-ban YouTube (Rapport §6) :
# YTDLP_COOKIES_FILE=/app/cookies.txt
# PROXY_URL=http://user:pass@proxy:8080
